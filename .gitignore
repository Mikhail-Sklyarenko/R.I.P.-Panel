# Local runtime data (vault, logs, config)
data/
# FSM import staging (operator-local; templates created at runtime)
data/import/logpass.txt
data/import/maFiles/*.maFile
data/import/maFiles/*.mafile

# Node (install on Windows in vendor/looter)
vendor/looter/node_modules/

# csgobot Python venv (separate from panel venv)
vendor/csgobot/venv/
# YOLO weights (download separately; never commit LFS pointers)
vendor/csgobot/**/*.pt

# Product / HF datasets (TRAIN machine only — never commit binaries)
vendor/csgobot/yolov8/datasets/hf_raw/
vendor/csgobot/yolov8/datasets/product_*/
vendor/csgobot/yolov8/datasets/sources/hf_converted/
vendor/csgobot/yolov8/runs/
vendor/csgobot/yolov8/datasets/sources/**/images/*
!vendor/csgobot/yolov8/datasets/sources/**/images/.gitkeep
vendor/csgobot/yolov8/datasets/sources/**/labels/*
!vendor/csgobot/yolov8/datasets/sources/**/labels/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
*.egg-info/
dist/
build/*
!build/build_windows.ps1
!build/farm_panel.spec
!build/requirements-build.txt
!build/README_RUN.txt
!build/smoke_frozen.ps1
!build/make_app_icon.py
*.spec.bak

# Secrets and Steam guard
*.maFile
.vault_key
logpass/
maFiles/

# Runtime logs and artifacts
**/events.jsonl
artifacts/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
